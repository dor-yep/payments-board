{
  "name": "payments-board",
  "version": "0.1.0",
  "description": "Monday.com app for amortization payments clearance",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test:pdf": "tsx scripts/generate-test-pdf.ts",
    "dev:server": "tsx watch src/index.ts",
    "dev:expose": "npx @mondaycom/apps-cli tunnel:create -p ${PORT:-3000} -a 11007042",
    "dev": "concurrently -n server,expose -c blue,green \"npm run dev:server\" \"npm run dev:expose\"",
    "deploy": "npm run build && npx @mondaycom/apps-cli code:push -d . -a 11007042",
    "deploy:live": "npm run build && npx @mondaycom/apps-cli code:push -d . -i 15370201 -f",
    "deploy:versions": "npx @mondaycom/apps-cli app-version:list -a 11007042"
  },
  "dependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "puppeteer": "^25.3.0",
    "puppeteer-core": "^25.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
